/* Claude Code-style chat layout: single column, minimal chrome, output above, prompt below. */

Screen {
    background: $background;
    layout: vertical;
}

#banner {
    height: 1;
    padding: 0 1;
    background: $background;
    color: $text-muted;
}

#log {
    height: 1fr;
    padding: 0 1;
    background: $background;
    scrollbar-size-vertical: 1;
}

#prompt-row {
    height: 3;
    padding: 0 1;
    layout: horizontal;
}

#prompt-context {
    width: auto;
    min-width: 4;
    height: 3;
    padding: 1 1 0 0;
    color: $primary;
    content-align: left middle;
}

#prompt {
    height: 3;
    border: round $primary-darken-2;
    background: $background;
    background-tint: $background 0%;
}

#prompt:focus {
    /* keep everything identical when focused — no border swap, no tint overlay */
    border: round $primary-darken-2;
    background: $background;
    background-tint: $background 0%;
}

Footer {
    background: $background;
    color: $text-muted;
}
